# ── Required ──────────────────────────────────────────────────────────
# From https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_api_hash_here
# From @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Your numeric Telegram user id (@userinfobot)
OWNER_ID=123456789

# ── Access control ────────────────────────────────────────────────────
# Space/comma-separated user ids. Empty = everyone may use the bot.
AUTHORIZED_USERS=
# 1 = only OWNER_ID may use the bot
OWNER_ONLY=0
# 1 = paid mode: only the owner, AUTHORIZED_USERS, and users with an active
# /grant may use the bot. 0 = open to everyone (default). Grant paid access
# with /grant <id|@username> <days>; it auto-expires.
SUBSCRIPTION_MODE=0

# ── Seedr (required for magnet links) ────────────────────────────────
# One account only (user + password).
SEEDR_USERNAME=
SEEDR_PASSWORD=
# HTTP proxy for Seedr API calls — only needed if Seedr blocks add_torrent
# from your host's IP (some Colab/Render/datacenter ranges). Many IPs work
# fine without it; test first and add a proxy only if magnet-adds are
# refused. Credentials in the URL are handled correctly (split into
# proxy_auth). Format: http://user:pass@host:port  (CDN downloads bypass it)
SEEDR_PROXY=
# Delete the Seedr folder after all its episodes are processed (1/0)
SEEDR_AUTO_DELETE=1
SEEDR_POLL_INTERVAL=10
SEEDR_TIMEOUT_HOURS=4

# ── Paths ─────────────────────────────────────────────────────────────
WORK_DIR=work
DOWNLOAD_DIR=downloads
DATABASE_PATH=data/bot.db
SESSION_DIR=data
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
ARIA2C_PATH=

# ── Limits ────────────────────────────────────────────────────────────
MAX_CONCURRENT_ENCODES=1
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_UPLOADS=2
MAX_JOBS_PER_USER=5
MAX_INPUT_SIZE_MB=4096
MAX_OUTPUT_SIZE_MB=2000
MIN_FREE_DISK_GB=2
JOB_TIMEOUT_HOURS=6
JOB_RETENTION_HOURS=72

# ── Encoding defaults ─────────────────────────────────────────────────
DEFAULT_VIDEO_CODEC=libx264
DEFAULT_AUDIO_CODEC=aac
DEFAULT_CRF=23
DEFAULT_PRESET=medium
DEFAULT_RESOLUTION=original
FALLBACK_FONT=Arial
# Preferred embedded-subtitle language to burn when a Seedr video has no
# separate subtitle file (e.g. fr for VOSTFR anime). Empty = default track.
PREFERRED_SUB_LANG=

# ── UX ────────────────────────────────────────────────────────────────
PROGRESS_UPDATE_INTERVAL=4
